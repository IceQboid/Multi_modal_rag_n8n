    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Safely access uploaded_images from Merge1\nconst mergeItem = $('Merge1').item;\nconst uploadedImages = mergeItem?.json?.uploaded_images;\n\nlet markdown = $json.markdown;\n\nconst supabaseBaseUrl = $('Supabase_account_details').item.json.supabase_base_url;\nconst bucketName = $('Supabase_account_details').item.json.supabase_storage_bucket_name;\n\n// Construct full base URL for public file access\nconst fullBaseUrl = `${supabaseBaseUrl}/storage/v1/object/public/${bucketName}/`;\n\n// Only run replacement if uploadedImages is a non-empty array\nif (Array.isArray(uploadedImages) && uploadedImages.length > 0) {\n  for (const image of uploadedImages) {\n    const image_id = image.image_id;\n    const fileName = image.file_name;\n    const annotation = image.image_annotation || '';\n\n    // Pattern of the local markdown before upload\n    const localMarkdownPattern = `![${image_id}](${image_id})`;\n\n    // Replacement pattern with hosted URL and annotation\n    const hostedMarkdownWithAnnotation = `![${image_id}](${fullBaseUrl}${fileName})\\n\\n${annotation}`;\n\n    // Replace only if the original pattern exists\n    if (markdown.includes(localMarkdownPattern)) {\n      markdown = markdown.replaceAll(localMarkdownPattern, hostedMarkdownWithAnnotation);\n    }\n  }\n}\n\n// Return updated markdown along with the existing JSON\nreturn {\n  json: {\n    ...$json,\n    markdown\n  }\n};\n"
      },
