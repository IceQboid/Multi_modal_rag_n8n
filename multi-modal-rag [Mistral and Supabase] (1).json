        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"model\": \"mistral-ocr-latest\",\n    \"document\": {\"document_url\": \"https://s3.diyprefab.com/zamil-manuals/additional_manuals/strength-of-material-by-r-k-bansal-31.pdf\"},\n    \"bbox_annotation_format\": {\n        \"type\": \"json_schema\",\n        \"json_schema\": {\n            \"schema\": {\n                \"title\": \"Engineering_Document_Annotation\",\n                \"type\": \"object\",\n                \"properties\": {\n                    \"document_title\": {\n                        \"type\": \"string\",\n                        \"description\": \"Full title or name of the document or standard (e.g., 'AISC 360-16 Specification for Structural Steel Buildings').\"\n                    },\n                    \"section_id\": {\n                        \"type\": \"string\",\n                        \"description\": \"Section, clause, or figure identifier (e.g., 'Section J2.2', 'Table 3-2', 'Clause 6.5').\"\n                    },\n                    \"section_title\": {\n                        \"type\": \"string\",\n                        \"description\": \"Title or heading of the section or table.\"\n                    },\n                    \"technical_summary\": {\n                        \"type\": \"string\",\n                        \"description\": \"A concise, clear summary of the technical content in this region (what rule, formula, or guideline it provides).\"\n                    },\n                    \"keywords\": {\n                        \"type\": \"array\",\n                        \"items\": {\"type\": \"string\"},\n                        \"description\": \"Key engineering terms mentioned (e.g., 'bending stress', 'yield strength', 'load combination').\"\n                    },\n                    \"equations_or_values\": {\n                        \"type\": \"array\",\n                        \"items\": {\"type\": \"string\"},\n                        \"description\": \"Mathematical expressions, formulae, or numerical data found in the text block.\"\n                    },\n                    \"reference_code\": {\n                        \"type\": \"string\",\n                        \"description\": \"Reference code or standard source (e.g., 'AISC 360-16', 'ASCE 7-22').\"\n                    }\n                },\n                \"required\": [\n                    \"document_title\",\n                    \"section_id\",\n                    \"technical_summary\"\n                ],\n                \"additionalProperties\": false\n            },\n            \"name\": \"engineering_doc_annotation\",\n            \"strict\": true\n        }\n    },\n    \"include_image_base64\": true\n}",
        "options": {
          "redirect": {
            "redirect": {}
          }
        }
